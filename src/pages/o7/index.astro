---
import Layout from '../../layouts/page.astro';
---

<style>
    :root {
        --fontStyle: "Pixelify Sans" !important;
        --splash: visible !important;
    }

    span {
        display: flex;
        flex-direction: row;
    }
</style>

<Layout band="The Phoneys", email="o7@toneys.band">
    <img src="https://assets.toneys.band/phoneys/o7.png" alt="The o7 Jazz Ensemble logo" width="600px"/>
	<h1>Welcome to The Phoneys!</h1>
	<p> Hello! We are the o7 Jazz Ensemble, a small jazz band focusing on the wonderful music from video games! 
        For reasons probably too complicated to explain, we also often refer to ourselves as the Phoneys</p>

	<h2>Meet the Band!</h2>
	<h3>Horns</h3>
	<p>
        Flute<br>
        Alto/Tenor Saxophone<br>
        Trumpet<br>
    </p>
    <h3>Strings</h3>
	<p>
        Cello
    </p>
	<h3>Rhythm</h3>
	<p>
		Piano<br>
        Double/Electric Bass<br>
        Rhythm Guitar<br>
        Lead Guitar,<br>
        Drums<br>
        Auxillary Percussion<br>
    </p>
    <br>
    <br>
</Layout>